# Copy this to .env (cp .env.example .env) and fill it in. .env is never committed to git.

# ---- The web address ----
# Port the app listens on (127.0.0.1 only; open it through an SSH tunnel). Change it if it's taken.
APP_PORT=8000
PUBLIC_URL=http://localhost:8000

# ---- Sign-in (Medha's) ----
AUTH_PROVIDER=demo
ALLOW_DEMO=1
SESSION_SECRET=dev-only-change-me
SESSION_HOURS=8
# Set these only when using CAS or OIDC.
CAS_SERVER_URL=
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_USER_CLAIM=preferred_username

# ---- The AI assistant ----
# Claude sign-in for the container. Make it with:  claude setup-token   (paste it as ONE line)
CLAUDE_CODE_OAUTH_TOKEN=
# The Judge's own database on the MongoDB server. Never grant_rag or affiliation (the code refuses).
MONGO_DB=grants

# ---- Running a second copy on the same machine ----
# Give it its own name and port, so it doesn't replace someone else's running copy.
# COMPOSE_PROJECT_NAME=grant-assistant-yourname
