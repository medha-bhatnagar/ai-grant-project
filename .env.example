# Copy this to .env on the VM (cp .env.example .env) and fill it in. .env is never committed to git.

# Claude sign-in for the containers. Make it with:  claude setup-token   (then paste it here)
CLAUDE_CODE_OAUTH_TOKEN=

# Our own database on the team's MongoDB server. Never grant_rag or affiliation (the code refuses).
MONGO_DB=grants

# Ports on the VM (only reachable through an SSH tunnel). Change them if a teammate uses these.
DASHBOARD_PORT=8090
JUDGE_PORT=8010
